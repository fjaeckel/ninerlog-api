      "icon": "external link"
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "ninerlog",
    "api",
    "airports"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(app_info, job)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "ninerlog-api",
          "value": "ninerlog-api",
          "selected": false
        },
        "hide": 0,
        "label": "Job"
      }
    ]
  },
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timezone": "",
  "title": "NinerLog API \u2014 Airport Database",
  "uid": "ninerlog-airports",
  "version": 1,
  "panels": [
    {
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "The in-memory airport database merges two upstream datasets (`ourairports` CSV, `mwgg` JSON) at startup and on every `AIRPORT_REFRESH_INTERVAL` tick (default 24h).\n\n**Watch age, not failures.** A single failed refresh is harmless \u2014 the previous snapshot keeps serving \u2014 so `airport_db_age_seconds` is the alertable signal, not `airport_db_reload_total{result=\"failed\"}`. Alert on a database that has stopped refreshing for days and is drifting from upstream.\n\n**`airport_lookup_total{result=\"unavailable\"}` above zero is user-visible:** flights are being served with no airport names, no distances, and no day/night calculation. A `rejected` reload means a fetch came back with under 50% of the live snapshot's records and the swap was refused \u2014 the guard working as designed, but the upstream needs a look."
      }
    },
    {
      "title": "Airports in Snapshot",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(airport_db_airports{job=\"$job\"})",
          "legendFormat": "airports"
        }
      ]
    },
    {
      "title": "Snapshot Age",
      "type": "stat",
      "description": "Seconds since the active snapshot was loaded. The primary staleness signal \u2014 alert here rather than on reload failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 172800
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(airport_db_age_seconds{job=\"$job\"})",
          "legendFormat": "age"
        }
      ]
    },
    {
      "title": "Lookups Served Without a Database",
      "type": "stat",
      "description": "airport_lookup_total{result=\"unavailable\"} \u2014 every one of these is a flight served with no airport name, distance, or night-time calculation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(airport_lookup_total{job=\"$job\", result=\"unavailable\"}[1h]))",
          "legendFormat": "unavailable (1h)"
        }
      ]
    },
    {
      "title": "Lookup Hit Ratio (1h)",
      "type": "stat",
      "description": "Share of exact/prefix/nearest lookups that found something. A sudden drop suggests the merge lost records.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(airport_lookup_total{job=\"$job\", result=\"hit\"}[1h])) / clamp_min(sum(rate(airport_lookup_total{job=\"$job\"}[1h])), 0.0001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "title": "Dropped Records (last merge)",
      "type": "stat",
      "description": "Records discarded by the last merge for unusable coordinates.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(airport_db_dropped_records{job=\"$job\"})",
          "legendFormat": "dropped"
        }
      ]
    },
    {
      "title": "Reload Outcomes",
      "type": "timeseries",
      "description": "success = both sources \u00b7 partial = one source failed \u00b7 failed = no source usable \u00b7 rejected = result under 50% of the live snapshot, swap refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "partial"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (increase(airport_db_reload_total{job=\"$job\"}[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Fetch Failures by Source & Reason",
      "type": "timeseries",
      "description": "request = network/DNS \u00b7 status = non-200 \u00b7 decode = schema drift or corrupt body \u00b7 empty = 0 records parsed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (source, reason) (increase(airport_db_fetch_errors_total{job=\"$job\"}[1h]))",
          "legendFormat": "{{source}} \u00b7 {{reason}}"
        }
      ]
    },
    {
      "title": "Fetch Duration p95 (by source)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (source, le) (rate(airport_db_fetch_duration_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Reload Timing",
      "type": "timeseries",
      "description": "Full reload (both fetches + merge + index) against merge-only, which excludes network time. A widening gap points at a slow upstream rather than slow merging.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airport_db_load_duration_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "full reload p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(airport_db_merge_duration_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "merge only p95"
        }
      ]
    },
    {
      "title": "Upstream Payload Size",
      "type": "timeseries",
      "description": "Bytes in the last successful download per source. A step change usually means the upstream schema moved.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (source) (airport_db_fetch_bytes{job=\"$job\"})",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Snapshot Composition (records by origin)",
      "type": "timeseries",
      "description": "Where the active snapshot's records came from: only in ourairports, only in mwgg, or present in both and merged.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (origin) (airport_db_records_by_origin{job=\"$job\"})",
          "legendFormat": "{{origin}}"
        }
      ]
    },
    {
      "title": "Records Parsed per Source (pre-merge)",
      "type": "timeseries",
      "description": "Records each upstream yielded on its last successful fetch, before merging. Compare against snapshot composition to see what the merge kept.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (source) (airport_db_source_records{job=\"$job\"})",
          "legendFormat": "{{source}} parsed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (source) (airport_db_merge_preferred{job=\"$job\"})",
          "legendFormat": "{{source}} won merge"
        }
      ]
    },
    {
      "title": "Fetch Attempts by Source & Result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (source, result) (increase(airport_db_fetch_total{job=\"$job\"}[1h]))",
          "legendFormat": "{{source}} \u00b7 {{result}}"
        }
      ]
    },
    {
      "title": "Lookups by Operation & Result",
      "type": "timeseries",
      "description": "lookup = exact ICAO \u00b7 search = ICAO prefix \u00b7 nearest = coordinates.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*unavailable.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (operation, result) (rate(airport_lookup_total{job=\"$job\"}[5m]))",
          "legendFormat": "{{operation}} \u00b7 {{result}}"
        }
      ]
    },
    {
      "title": "Lookup Latency p95 (scanning operations)",
      "type": "timeseries",
      "description": "Only 'search' and 'nearest' are timed \u2014 exact-match lookup is a single map hit and is not instrumented.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(airport_lookup_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "{{operation}} p95"
        }
      ]
    },
    {
      "title": "Pack Requests by Endpoint & Result",
      "type": "timeseries",
      "description": "pack = full download \u00b7 status = freshness probe. Clients should mostly hit status and only download on a changed etag.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*unavailable.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (endpoint, result) (rate(airport_pack_requests_total{job=\"$job\"}[5m]))",
          "legendFormat": "{{endpoint}} \u00b7 {{result}}"
        }
      ]
    },
    {
      "title": "Pack Size (gzip)",
      "type": "timeseries",
      "description": "Compressed size of the current downloadable pack.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
