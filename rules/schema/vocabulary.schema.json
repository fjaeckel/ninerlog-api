{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninerlog.com/schema/rules/vocabulary.schema.json",
  "title": "Closed vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "catalogue_authorities", "source_kinds", "support_levels", "record_authorities", "categories", "classes", "ul_kinds", "launch_methods", "licence_kinds", "privilege_kinds", "credential_types", "flight_flags", "event_kinds", "record_fields", "minute_fields", "subjects", "statuses", "units", "metrics", "filters", "roles", "windows", "combinators", "stage_conditions", "rule_events", "param_sources", "validity", "hatches"],
  "properties": {
    "version": { "type": "integer" },
    "catalogue_authorities": { "$ref": "#/$defs/names" },
    "source_kinds": { "$ref": "#/$defs/described" },
    "support_levels": { "$ref": "#/$defs/names" },
    "record_authorities": { "$ref": "#/$defs/names" },
    "categories": { "$ref": "#/$defs/names" },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category"],
        "properties": { "category": { "type": "string" } }
      }
    },
    "ul_kinds": { "$ref": "#/$defs/names" },
    "launch_methods": { "$ref": "#/$defs/names" },
    "fstd_types": { "$ref": "#/$defs/names" },
    "tow_kinds": { "$ref": "#/$defs/names" },
    "licence_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aliases"],
        "properties": { "aliases": { "$ref": "#/$defs/names" } }
      }
    },
    "privilege_kinds": { "$ref": "#/$defs/names" },
    "credential_types": { "$ref": "#/$defs/names" },
    "flight_flags": { "$ref": "#/$defs/names" },
    "event_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "from_flag": { "type": "string" } }
      }
    },
    "record_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": { "type": { "type": "string" }, "optional": { "type": "boolean" } }
      }
    },
    "minute_fields": { "$ref": "#/$defs/names" },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": { "description": { "type": "string" }, "expiry": { "type": "boolean" } }
      }
    },
    "statuses": { "$ref": "#/$defs/described" },
    "units": { "$ref": "#/$defs/names" },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "aggregate", "reads", "units", "description"],
        "properties": {
          "source": { "enum": ["flights", "events"] },
          "aggregate": { "enum": ["sum", "max", "min_of_sums", "none"] },
          "reads": { "type": "array", "items": { "type": "string" } },
          "optional": { "type": "boolean" },
          "units": { "$ref": "#/$defs/names" },
          "description": { "type": "string" }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applies_to", "reads", "values", "description"],
        "properties": {
          "applies_to": { "type": "array", "items": { "enum": ["flights", "events"] } },
          "reads": { "type": "array", "items": { "type": "string" } },
          "values": {},
          "subject_ref": { "type": "boolean" },
          "absent": { "enum": ["unknown", "no_match", "match"] },
          "description": { "type": "string" }
        }
      }
    },
    "roles": { "$ref": "#/$defs/names" },
    "windows": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["param", "description"],
        "properties": {
          "param": {},
          "moving": { "type": "boolean" },
          "anchor": { "enum": ["expiry", "issue"] },
          "description": { "type": "string" }
        }
      }
    },
    "combinators": { "$ref": "#/$defs/described" },
    "stage_conditions": { "$ref": "#/$defs/described" },
    "missing_inputs": { "$ref": "#/$defs/names" },
    "rule_events": { "$ref": "#/$defs/described" },
    "param_sources": { "$ref": "#/$defs/described" },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "period_conditions", "period_fields"],
      "properties": {
        "anchors": { "$ref": "#/$defs/names" },
        "period_conditions": { "$ref": "#/$defs/names" },
        "period_fields": { "$ref": "#/$defs/names" }
      }
    },
    "hatches": { "$ref": "#/$defs/described" }
  },
  "$defs": {
    "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "described": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
  }
}
