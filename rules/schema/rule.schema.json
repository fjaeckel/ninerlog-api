{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninerlog.com/schema/rules/rule.schema.json",
  "title": "Catalogue rule",
  "description": "One rule file under catalogue/ (DESIGN.md section 6). Names of metrics, filters, windows, conditions, subjects, units and message keys are checked against vocabulary.yaml and messages/keys.yaml by rulescheck.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authority", "instrument", "article", "support", "source_kind", "source", "applies_to"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$" },
    "title": { "type": "string", "minLength": 1 },
    "authority": { "type": "string" },
    "instrument": { "type": "string", "minLength": 1 },
    "article": { "type": "string", "minLength": 1 },
    "support": { "enum": ["supported", "partial", "not_supported"] },
    "source_kind": { "type": "string" },
    "effective_from": { "$ref": "#/$defs/dateOrNull" },
    "effective_to": { "$ref": "#/$defs/dateOrNull" },
    "source": { "$ref": "#/$defs/source" },
    "related_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "citations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "applies_to": { "$ref": "#/$defs/appliesTo" },
    "window": { "$ref": "#/$defs/window" },
    "filter": { "$ref": "#/$defs/filter" },
    "validity": { "$ref": "#/$defs/validity" },
    "requirements": { "$ref": "#/$defs/node" },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
    "restored_by": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
    "resets": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
    "ruleDescriptionKey": { "type": "string" },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "api", "article", "cite"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "api": { "type": "string", "minLength": 1 },
          "article": { "type": "string", "minLength": 1 },
          "cite": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "if": { "properties": { "support": { "enum": ["supported", "partial"] } } },
  "then": { "required": ["stages"] },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateOrNull": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cite", "url", "file", "quote"],
      "properties": {
        "cite": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "file": { "type": "string", "pattern": "^sources/" },
        "quote": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/strings" }
          ]
        }
      }
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": { "type": "string" },
        "authorities": { "$ref": "#/$defs/strings" },
        "excludeAuthorities": { "$ref": "#/$defs/strings" },
        "licenceKinds": { "$ref": "#/$defs/strings" },
        "excludeLicenceKinds": { "$ref": "#/$defs/strings" },
        "classes": { "$ref": "#/$defs/strings" },
        "excludeClasses": { "$ref": "#/$defs/strings" },
        "ulKinds": { "$ref": "#/$defs/strings" },
        "privilegeKinds": { "$ref": "#/$defs/strings" },
        "credentialTypes": { "$ref": "#/$defs/strings" },
        "launchMethods": { "$ref": "#/$defs/strings" },
        "programme": { "type": "string", "minLength": 1 },
        "holds": { "$ref": "#/$defs/holds" }
      }
    },
    "window": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "rolling_days": { "type": "integer", "minimum": 1 },
        "rolling_months": { "type": "integer", "minimum": 1 },
        "calendar_months": { "type": "integer", "minimum": 1 },
        "before_expiry_months": { "type": "integer", "minimum": 1 },
        "validity_period": { "const": true },
        "since_issue": { "enum": ["licence", "subject"] },
        "lifetime": { "const": true }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": { "$ref": "#/$defs/strings" },
        "excludeClasses": { "$ref": "#/$defs/strings" },
        "heldClassPools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/strings" } },
        "categories": { "$ref": "#/$defs/strings" },
        "ulKinds": { "$ref": "#/$defs/strings" },
        "ulCredit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "ulKinds"],
            "properties": {
              "class": { "type": "string" },
              "ulKinds": { "$ref": "#/$defs/strings" },
              "minMtomKg": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "launchMethods": { "$ref": "#/$defs/strings" },
        "excludeLaunchMethods": { "$ref": "#/$defs/strings" },
        "typeDesignators": { "$ref": "#/$defs/strings" },
        "variants": { "$ref": "#/$defs/strings" },
        "roles": { "$ref": "#/$defs/strings" },
        "withMinutes": { "$ref": "#/$defs/strings" },
        "withoutMinutes": { "$ref": "#/$defs/strings" },
        "simulator": { "enum": ["exclude", "only", "include"] },
        "fstdTypes": { "$ref": "#/$defs/strings" },
        "flags": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "boolean" } },
        "minMinutes": { "type": "integer", "minimum": 1 },
        "minLandings": { "type": "integer", "minimum": 1 },
        "minDistanceKm": { "type": "number", "exclusiveMinimum": 0 },
        "tailwheel": { "type": "boolean" },
        "soleManipulator": { "type": "boolean" },
        "pilotFlying": { "type": "boolean" },
        "towKinds": { "$ref": "#/$defs/strings" },
        "eventKinds": { "$ref": "#/$defs/strings" },
        "eventRatings": { "$ref": "#/$defs/strings" },
        "any": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/filter" } }
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "metric": { "type": "string" },
        "min": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "nameKey": { "type": "string" },
        "remedyKey": { "type": "string" },
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "met": { "type": "string" },
            "unmet": { "type": "string" },
            "untracked": { "type": "string" }
          }
        },
        "informational": { "type": "boolean" },
        "escape_hatch": { "type": "string" },
        "window": { "$ref": "#/$defs/window" },
        "filter": { "$ref": "#/$defs/filter" },
        "when": { "$ref": "#/$defs/condition" },
        "all_of": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "any_of": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/node" } },
        "n_of": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n", "of"],
          "properties": {
            "n": { "type": "integer", "minimum": 1 },
            "of": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/node" } }
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["metric", "min", "unit", "nameKey", "id"], "not": { "anyOf": [{ "required": ["all_of"] }, { "required": ["any_of"] }, { "required": ["n_of"] }] } },
        { "required": ["all_of"], "not": { "anyOf": [{ "required": ["metric"] }, { "required": ["any_of"] }, { "required": ["n_of"] }] } },
        { "required": ["any_of", "id"], "not": { "anyOf": [{ "required": ["metric"] }, { "required": ["all_of"] }, { "required": ["n_of"] }] } },
        { "required": ["n_of", "id"], "not": { "anyOf": [{ "required": ["metric"] }, { "required": ["all_of"] }, { "required": ["any_of"] }] } }
      ]
    },
    "condition": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "met": { "type": "string" },
            "unmet": { "type": "string" },
            "untracked": { "type": "string" },
            "missing": { "type": "string" },
            "expires_within": {
              "type": "object",
              "additionalProperties": false,
              "required": ["days"],
              "properties": { "days": { "type": "integer", "minimum": 0 } }
            },
            "met_within": { "$ref": "#/$defs/window" },
            "holds": { "$ref": "#/$defs/holds" },
            "all": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/condition" } },
            "any": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/condition" } },
            "not": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    },
    "holds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "classes": { "$ref": "#/$defs/strings" },
        "ulKinds": { "$ref": "#/$defs/strings" },
        "licenceKinds": { "$ref": "#/$defs/strings" },
        "privileges": { "$ref": "#/$defs/strings" },
        "credentials": { "$ref": "#/$defs/strings" },
        "sameLicence": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "every": { "type": "boolean" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "status", "messageKey"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "when": { "$ref": "#/$defs/condition" },
        "status": { "type": "string" },
        "messageKey": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": { "type": "string" } }
            ]
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "type": "string" },
        "filter": { "$ref": "#/$defs/filter" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "periods"],
      "properties": {
        "from": { "type": "string" },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["months"],
            "properties": {
              "when": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
              "months": { "type": "integer", "minimum": 1 },
              "cap_at_age": { "type": "integer", "minimum": 1 },
              "end_of_month": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
