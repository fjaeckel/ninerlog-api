# =============================================================================
# NinerLog API — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ninerlog:changeme@localhost:5432/ninerlog?sslmode=disable

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
GIN_MODE=debug          # debug | release | test
LOG_LEVEL=info          # debug | info | warn | error

# -----------------------------------------------------------------------------
# Authentication — CHANGE THESE IN PRODUCTION
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-secret-key-in-production
REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Database Migrations
# -----------------------------------------------------------------------------
MIGRATIONS_PATH=db/migrations

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# DISABLE_RATE_LIMIT=true   # Only set for testing

# -----------------------------------------------------------------------------
# Licence / credential reference images
# -----------------------------------------------------------------------------
# Photos or scans attached to a licence or credential (max 5 MB, 5 per document,
# JPEG/PNG only). Set to false to close the feature entirely — uploads *and*
# downloads then answer 403. Stored images are kept and reappear if re-enabled.
# DOCUMENT_IMAGES_ENABLED=false

# -----------------------------------------------------------------------------
# SMTP / Email (optional — emails are logged to stdout when SMTP_HOST is empty)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@ninerlog.com

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# NOTIFICATION_CHECK_INTERVAL=1h   # Go duration string

# -----------------------------------------------------------------------------
# Airport database (OurAirports + mwgg/Airports, merged in memory)
# -----------------------------------------------------------------------------
# How often both datasets are refetched and re-merged. Go duration string;
# "off" or "0s" loads once at startup and never refreshes.
# AIRPORT_REFRESH_INTERVAL=24h

# -----------------------------------------------------------------------------
# WebAuthn / Passkeys (optional — disabled unless WEBAUTHN_RP_ID is set)
# -----------------------------------------------------------------------------
# Relying Party ID: the registrable domain passkeys are bound to. Must be the
# site's domain without scheme or port (e.g. "ninerlog.com", "localhost" in dev).
# WEBAUTHN_RP_ID=localhost
# Display name shown by the authenticator during a ceremony.
# WEBAUTHN_RP_NAME=NinerLog
# Comma-separated allowed origins. Defaults to CORS_ORIGIN when unset.
# WEBAUTHN_RP_ORIGINS=http://localhost:5173
# How long an in-flight ceremony stays valid. Go duration string. Also used as
# the client-side ceremony timeout, so the stored challenge never outlives the
# browser prompt that produced it.
# WEBAUTHN_SESSION_TTL=5m
# Maximum ceremonies one user may hold open at once. Exceeding it evicts the
# oldest, so a user's most recent attempt always works.
# WEBAUTHN_MAX_OPEN_CEREMONIES=10

# -----------------------------------------------------------------------------
# OIDC single sign-on (optional — disabled unless OIDC_ISSUER is set)
# -----------------------------------------------------------------------------
# Setting OIDC_ISSUER is a MODE SWITCH, not an extra login button: the identity
# provider then owns every account, and password login, self-service
# registration, email verification, password reset, TOTP and passkeys are all
# disabled (they answer 503). Full guide: docs/OIDC.md
#
# A half-configured provider is fatal at startup rather than silent — with the
# issuer set, every required variable below must be present and well-formed.

# Issuer URL. Must match the `iss` claim exactly and resolve
# <issuer>/.well-known/openid-configuration. No query string or fragment.
# OIDC_ISSUER=https://id.example.com/application/o/ninerlog/
# OIDC_CLIENT_ID=ninerlog
# OIDC_CLIENT_SECRET=
# This API's own callback, exactly as registered with the provider.
# OIDC_REDIRECT_URL=https://api.example.com/api/v1/auth/oidc/callback
# Where the browser lands after a successful login (a frontend URL). Fixed here
# and never taken from the request, so the callback cannot be used as an open
# redirect.
# OIDC_POST_LOGIN_REDIRECT=https://app.example.com/auth/callback

# Label on the sign-in button ("Sign in with ...").
# OIDC_PROVIDER_NAME=Single sign-on
# Comma- or space-separated. "openid" is added automatically.
# OIDC_SCOPES=openid,profile,email
# Claim used as the pilot's display name; falls back to name, then
# preferred_username, then the local part of the email address.
# OIDC_NAME_CLAIM=name
# Let a first OIDC login adopt an existing local account with the same address.
# Off by default — only enable while migrating an existing deployment, and only
# if users cannot set an arbitrary email at your provider. Requires the ID
# token to assert email_verified. See docs/OIDC.md#migrating-an-existing-deployment
# OIDC_LINK_BY_VERIFIED_EMAIL=false
# Treat addresses as verified even when the provider sends no email_verified
# claim (Authelia, Entra ID). Also required for ADMIN_EMAIL to take effect with
# such a provider, since admin status demands a verified address.
# OIDC_TRUST_EMAIL_VERIFIED=false
# How long a started login stays completable (the window to authenticate at the
# provider), and how long the post-login handoff code stays redeemable.
# OIDC_LOGIN_STATE_TTL=10m
# OIDC_HANDOFF_TTL=60s

# -----------------------------------------------------------------------------
# Idempotent writes (Idempotency-Key header — always on, opt-in per request)
# -----------------------------------------------------------------------------
# How long a key stays replayable. Go duration string. Sized for a realistic
# offline window: a flight logged with no signal, replayed once back on the
# ground.
# IDEMPOTENCY_TTL=24h
# How long an in-progress claim is honoured before another request may take it
# over. Must exceed the 15s request timeout so a slow-but-alive request is never
# displaced; keeps a crashed process from wedging a key for the whole TTL.
# IDEMPOTENCY_LEASE=60s
# Largest response body stored for replay. A larger response still reaches the
# client; only its replay record is dropped, and the retry is then refused
# rather than re-executed.
# IDEMPOTENCY_MAX_RESPONSE_BYTES=262144

# -----------------------------------------------------------------------------
# Delta sync (updatedSince + GET /sync/deletions)
# -----------------------------------------------------------------------------
# How long a deletion stays reportable to a syncing client. Go duration string.
# A client whose watermark is older than this is told so explicitly and must
# fall back to a full ID-set reconciliation, so shortening this shifts work onto
# clients rather than losing deletes silently.
# TOMBSTONE_RETENTION=2160h
