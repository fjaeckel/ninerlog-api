# =============================================================================
# NinerLog API — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for local development.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ninerlog:changeme@localhost:5432/ninerlog?sslmode=disable

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
GIN_MODE=debug          # debug | release | test
LOG_LEVEL=info          # debug | info | warn | error

# -----------------------------------------------------------------------------
# Authentication — CHANGE THESE IN PRODUCTION
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-secret-key-in-production
REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Database Migrations
# -----------------------------------------------------------------------------
MIGRATIONS_PATH=db/migrations

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# DISABLE_RATE_LIMIT=true   # Only set for testing

# -----------------------------------------------------------------------------
# SMTP / Email (optional — emails are logged to stdout when SMTP_HOST is empty)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@ninerlog.com

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# NOTIFICATION_CHECK_INTERVAL=1h   # Go duration string

# -----------------------------------------------------------------------------
# Airport database (OurAirports + mwgg/Airports, merged in memory)
# -----------------------------------------------------------------------------
# How often both datasets are refetched and re-merged. Go duration string;
# "off" or "0s" loads once at startup and never refreshes.
# AIRPORT_REFRESH_INTERVAL=24h

# -----------------------------------------------------------------------------
# WebAuthn / Passkeys (optional — disabled unless WEBAUTHN_RP_ID is set)
# -----------------------------------------------------------------------------
# Relying Party ID: the registrable domain passkeys are bound to. Must be the
# site's domain without scheme or port (e.g. "ninerlog.com", "localhost" in dev).
# WEBAUTHN_RP_ID=localhost
# Display name shown by the authenticator during a ceremony.
# WEBAUTHN_RP_NAME=NinerLog
# Comma-separated allowed origins. Defaults to CORS_ORIGIN when unset.
# WEBAUTHN_RP_ORIGINS=http://localhost:5173
# How long an in-flight ceremony stays valid. Go duration string. Also used as
# the client-side ceremony timeout, so the stored challenge never outlives the
# browser prompt that produced it.
# WEBAUTHN_SESSION_TTL=5m
# Maximum ceremonies one user may hold open at once. Exceeding it evicts the
# oldest, so a user's most recent attempt always works.
# WEBAUTHN_MAX_OPEN_CEREMONIES=10

# -----------------------------------------------------------------------------
# Idempotent writes (Idempotency-Key header — always on, opt-in per request)
# -----------------------------------------------------------------------------
# How long a key stays replayable. Go duration string. Sized for a realistic
# offline window: a flight logged with no signal, replayed once back on the
# ground.
# IDEMPOTENCY_TTL=24h
# How long an in-progress claim is honoured before another request may take it
# over. Must exceed the 15s request timeout so a slow-but-alive request is never
# displaced; keeps a crashed process from wedging a key for the whole TTL.
# IDEMPOTENCY_LEASE=60s
# Largest response body stored for replay. A larger response still reaches the
# client; only its replay record is dropped, and the retry is then refused
# rather than re-executed.
# IDEMPOTENCY_MAX_RESPONSE_BYTES=262144
